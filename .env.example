# SIH26187 — AI Border Surveillance System
# Copy to .env and fill in your own values. NEVER commit the real .env.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# ---------------------------------------------------------------- Database
# PostgreSQL 16+. Both URLs point at the same database (async for the app, sync for Alembic).
DATABASE_URL=postgresql+asyncpg://USERNAME:PASSWORD@localhost:5432/sih26187
DATABASE_URL_SYNC=postgresql+psycopg2://USERNAME:PASSWORD@localhost:5432/sih26187
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=False

# ---------------------------------------------------------------- Security
# Generate your own key:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=generate-your-own-256-bit-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------- Storage paths
EVIDENCE_PATH=/path/to/evidence/
SNAPSHOTS_PATH=/path/to/evidence/snapshots/
CLIPS_PATH=/path/to/evidence/clips/
MODELS_PATH=/path/to/models/
LOGS_PATH=/path/to/logs/
DATASETS_PATH=/path/to/datasets/

# ---------------------------------------------------------------- Detection & behaviour
CAMERA_OFFLINE_THRESHOLD_SECONDS=30
HEALTH_CHECK_INTERVAL_SECONDS=30
LOITER_THRESHOLD_SECONDS=30
ALERT_COOLDOWN_SECONDS=15
CONF_THRESHOLD=0.4
TRAIL_LENGTH=50
NIGHT_START_HOUR=22
NIGHT_END_HOUR=5
NIGHT_BRIGHTNESS_THRESHOLD=80
NIGHT_RISK_MULTIPLIER=1.5
HOT_STORAGE_DAYS=7

# ---------------------------------------------------------------- Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# ---------------------------------------------------------------- Admin account (created by seed_admin.py)
# Change before any deployment. The API rejects passwords that contain the username.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-strong-password-here
ADMIN_EMAIL=admin@yourdomain.gov.in

# ---------------------------------------------------------------- API limits
UPLOAD_MAX_SIZE_MB=500
ALLOWED_VIDEO_TYPES=mp4,avi,mov,mkv
ALLOWED_IMAGE_TYPES=jpg,jpeg,png
JWT_BLACKLIST_ENABLED=False
RATE_LIMIT_PER_MINUTE=100
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CAMERA_MONITOR_ENABLED=True
LOG_LEVEL=INFO

# ---------------------------------------------------------------- ML pipeline (optional — defaults shown)
# The pipeline logs into the backend with these credentials (falls back to ADMIN_USERNAME / ADMIN_PASSWORD).
# ML_USERNAME=admin
# ML_PASSWORD=your-strong-password-here
# ML_BACKEND_URL=http://localhost:8000
# ML_BACKEND_WS_URL=ws://localhost:8000
# ML_MODEL_NAME=yolov8x.pt
# Pin the weights file: python -c "import hashlib,pathlib; print(hashlib.sha256(pathlib.Path('models/yolov8x.pt').read_bytes()).hexdigest())"
# ML_MODEL_SHA256=
# ML_USE_TENSORRT=True          # falls back to PyTorch when models/yolov8x.engine is missing
# ML_IMAGE_SIZE=640
# ML_HALF_PRECISION=True
# ML_DETECT_ANIMALS=True
# ML_DETECT_WEAPONS=True
# ML_TRACK_BUFFER=90            # ByteTrack memory for a lost track, in frames
# ML_TRACK_NEW_CONF=0.30        # confidence needed to START a track (distant/blurred people score 0.25-0.35)
# ML_ANALYSIS_IMAGE_SIZE=960    # offline video analysis input size (640 live; larger finds small figures)
# ML_ANALYSIS_FRAME_STEP=0      # 0 = every frame, stepping up only for long recordings
# ML_ANALYSIS_MAX_FRAMES=4000   # frame budget per analysis job, so a long video still finishes
# ML_ANALYSIS_USE_TENSORRT=False  # the engine is built for the live size, so analysis uses PyTorch
# ML_REID_ENABLED=True          # stable identity id when the same person reappears
# ML_REID_WINDOW_SECONDS=600
# ML_REID_MAX_DISTANCE=0.45
# ML_WS_SEND_FPS=10             # annotated frames pushed to the console
# ML_DETECTION_PUBLISH_HZ=2     # detections written to the database
# ML_PRE_ALERT_SECONDS=15
# ML_POST_ALERT_SECONDS=15
# ML_RECORD_CLIPS=True
