# Frontend build settings. Copy to frontend/.env.local (git-ignored) and fill in what you have.
# Everything prefixed with VITE_ is compiled into the browser bundle, so never put a server secret here.
# Both keys are optional: without them the console works, and the street-view panel explains what to add.

# Google Street View + Google basemaps. Google Maps Platform key with "Maps JavaScript API" enabled.
# Needs a billing account on Google Cloud. Restrict the key to your console's HTTP referrer before use.
VITE_GOOGLE_MAPS_KEY=

# Mapillary open street-level imagery. Free client token from https://www.mapillary.com/dashboard/developers
# (no payment method needed). Coverage varies — cities are well covered, remote border roads often are not.
VITE_MAPILLARY_TOKEN=
